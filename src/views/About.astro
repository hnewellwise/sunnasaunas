---
import { render, type CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/config';

interface Props {
  lang: Locale;
  entry: CollectionEntry<'pages'>;
}

const { lang, entry } = Astro.props;
const { Content } = await render(entry);
// TODO(build): replicate /en/about section by section (see migration/snapshot/html/en/about.html).
// Copy goes in src/content/pages/<lang>/about.md (sections frontmatter), markup here.
---

<article class="page page-about" data-lang={lang}>
  <h1>{entry.data.title}</h1>
  <Content />
</article>
