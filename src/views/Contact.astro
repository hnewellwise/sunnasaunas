---
import { render, type CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/config';
import OpnForm from '../components/OpnForm.astro';

interface Props {
  lang: Locale;
  entry: CollectionEntry<'pages'>;
}

const { lang, entry } = Astro.props;
const { Content } = await render(entry);
// TODO(build): replicate /en/contact section by section (see migration/snapshot/html/en/contact.html).
// Copy goes in src/content/pages/<lang>/contact.md (sections frontmatter), markup here.
---

<article class="page page-contact" data-lang={lang}>
  <h1>{entry.data.title}</h1>
  <Content />
  <OpnForm lang={lang} />
</article>
