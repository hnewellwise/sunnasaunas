---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/config';

interface Props {
  lang: Locale;
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, heroImage, heroAlt, gallery } = entry.data;
// TODO(build): replicate the Squarespace portfolio item layout (gallery grid + lightbox).
---

<article class="work-entry">
  <h1>{title}</h1>
  {heroImage && <Image src={heroImage} alt={heroAlt ?? ''} widths={[640, 1280, 1920]} sizes="100vw" />}
  <Content />
  {gallery.length > 0 && (
    <div class="gallery">
      {gallery.map((img) => <Image src={img.src} alt={img.alt} widths={[400, 800]} sizes="(min-width: 768px) 33vw, 100vw" />)}
    </div>
  )}
</article>
