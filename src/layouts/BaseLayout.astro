---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { localeMeta, isPublished, type Locale } from '../i18n/config';
import type { Alternate } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  alternates: Alternate[];
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { lang, alternates, jsonLd, ...seo } = Astro.props;
---

<!doctype html>
<html lang={localeMeta[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <Seo lang={lang} alternates={alternates} {...seo} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'a11y.skip')}</a>
    {!isPublished(lang) && <div class="draft-banner" role="note">{t(lang, 'draft.banner')}</div>}
    <Header lang={lang} alternates={alternates} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
