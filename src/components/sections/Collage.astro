---
import SectionWrap from './SectionWrap.astro';
import Img from '../Img.astro';
import type { Locale } from '../../i18n/config';
import type { CollageSection } from './types';
import { mdInline } from '../../lib/markdown';

interface Props {
  section: CollageSection;
  lang: Locale;
}

// Home page "Not only a sauna" block: three overlapping photos with the heading on the right.
const { section: s, lang } = Astro.props;
const [a, b, c] = s.images;
---

<SectionWrap theme={s.theme ?? 'clay'} height={s.height} id={s.id}>
  <div class="collage">
    <h2 class="heading" data-reveal set:html={mdInline(s.heading, lang)} />
    {a && <div class="p p1" data-reveal><Img src={a.src} alt={a.alt ?? ''} sizes="(min-width: 768px) 33vw, 88vw" /></div>}
    {b && <div class="p p2" data-reveal><Img src={b.src} alt={b.alt ?? ''} sizes="(min-width: 768px) 16vw, 54vw" /></div>}
    {c && <div class="p p3" data-reveal><Img src={c.src} alt={c.alt ?? ''} sizes="(min-width: 768px) 26vw, 88vw" /></div>}
  </div>
</SectionWrap>

<style>
  /* Desktop positions mirror the Squarespace fluid-engine grid (x/w in vw from the 1440 capture). */
  .collage {
    position: relative;
    height: 44vw;
  }
  .p {
    position: absolute;
    overflow: hidden;
    border-radius: var(--radius-img);
  }
  .p :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .p1 { left: 0; top: 0; width: 33vw; height: 26.5vw; }
  .p2 { left: 34vw; top: 7.5vw; width: 16vw; height: 29vw; z-index: 1; }
  .p3 { left: 7vw; top: 27.2vw; width: 26vw; height: 16.6vw; }
  .heading {
    position: absolute;
    left: 50vw;
    top: 0;
    width: 26vw;
    text-align: center;
    font-size: var(--fs-h3);
  }
  /* Mobile positions from the 390px capture (vw of a 390px viewport). */
  @media (max-width: 767px) {
    .collage { height: 204vw; }
    .p1 { left: 0; top: 0; width: 88vw; height: 51vw; }
    .heading { left: 0; top: 53.8vw; width: 88vw; }
    .p2 { left: 34vw; top: 89.7vw; width: 54vw; height: 60vw; }
    .p3 { left: 0; top: 107.7vw; width: 88vw; height: 96vw; }
  }
</style>
