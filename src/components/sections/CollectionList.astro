---
import { Image } from 'astro:assets';
import SectionWrap from './SectionWrap.astro';
import type { Locale } from '../../i18n/config';
import type { CollectionSection } from './types';
import { pathFor } from '../../i18n/routes';
import { entriesFor, slugOf } from '../../lib/content';
import { formatDate } from '../../lib/dates';
import { t } from '../../i18n/ui';

interface Props {
  section: CollectionSection;
  lang: Locale;
}

// circle: Squarespace blog list (image left; date, big sage title, "Read More" right).
// work: Squarespace portfolio grid (2 columns of square cover images, title on hover).
const { section: s, lang } = Astro.props;
const entries = await entriesFor(s.collection, lang);
---

<SectionWrap theme={s.theme} height={s.height} id={s.id}>
  {s.collection === 'circle' ? (
    <ul class="posts">
      {entries.map((e) => {
        const href = pathFor('circle', lang, slugOf(e));
        const date = 'pubDate' in e.data ? e.data.pubDate : e.data.date;
        return (
          <li data-reveal>
            <a class="thumb" href={href} tabindex="-1" aria-hidden="true">
              {e.data.heroImage && <Image src={e.data.heroImage} alt="" widths={[400, 800]} sizes="(min-width: 768px) 31vw, 88vw" />}
            </a>
            <div>
              <time datetime={date.toISOString()}>{formatDate(date, lang, 'numeric')}</time>
              <h2><a href={href}>{e.data.title}</a></h2>
              <a class="more" href={href}>{t(lang, 'blog.readMore')}</a>
            </div>
          </li>
        );
      })}
    </ul>
  ) : (
    <ul class="work">
      {entries.map((e) => (
        <li data-reveal>
          <a href={pathFor('work', lang, slugOf(e))}>
            {e.data.heroImage && <Image src={e.data.heroImage} alt="" widths={[500, 900]} sizes="(min-width: 768px) 39vw, 88vw" />}
            <span class="name">{e.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  )}
</SectionWrap>

<style>
  .posts {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 78vw;
  }
  .posts li {
    display: grid;
    grid-template-columns: 31vw 1fr;
    gap: 4.6vw;
    align-items: center;
    margin-bottom: 1.6vw;
  }
  .posts :global(img) {
    aspect-ratio: 1;
    width: 100%;
    object-fit: cover;
  }
  .posts time {
    display: block;
    font-size: 11px;
    color: var(--sage);
    margin-bottom: 1.4em;
  }
  .posts h2 {
    font-size: var(--fs-h2);
    line-height: 1.12;
    margin-bottom: 0.5em;
  }
  .posts h2 a {
    color: var(--sage);
    text-decoration: none;
  }
  .more {
    font-size: 12px;
    color: var(--olive);
  }

  .work {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.6vw;
  }
  .work a {
    position: relative;
    display: block;
  }
  .work :global(img) {
    aspect-ratio: 1;
    width: 100%;
    object-fit: cover;
  }
  .name {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1em;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--fs-h4);
    letter-spacing: -0.04em;
    color: #fff;
    background: rgba(60, 66, 44, 0.45);
    opacity: 0;
    transition: opacity 0.25s;
  }
  .work a:hover .name,
  .work a:focus-visible .name {
    opacity: 1;
  }
  @media (max-width: 767px) {
    .posts {
      max-width: none;
    }
    .posts li {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-bottom: 48px;
    }
    .posts h2 {
      font-size: var(--fs-h3);
    }
    .work {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .name {
      opacity: 1;
      inset: auto 0 0 0;
      justify-content: flex-start;
      background: linear-gradient(transparent, rgba(60, 66, 44, 0.6));
      font-size: 22px;
    }
  }
</style>
