---
import type { Locale } from '../i18n/config';
import { resolveHref } from '../lib/links';

export type ButtonData = { text: string; href: string; kind?: 'primary' | 'secondary' | 'tertiary' | 'inverse'; wide?: boolean };

interface Props extends ButtonData {
  lang: Locale;
  class?: string;
}

const { text, href, kind = 'primary', wide, lang, class: cls } = Astro.props;
const url = resolveHref(href, lang);
const external = /^https?:/.test(url);
---

<a
  class:list={['btn', `btn--${kind}`, { 'btn--wide': wide }, cls]}
  href={url}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}>{text}</a
>
