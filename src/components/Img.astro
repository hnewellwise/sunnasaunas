---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { loadImage } from '../lib/images';

interface Props {
  /** Filename in src/assets/images/, or imported image metadata. */
  src: string | ImageMetadata;
  alt?: string;
  sizes?: string;
  widths?: number[];
  class?: string;
  loading?: 'lazy' | 'eager';
  style?: string;
}

const { src, alt = '', sizes = '100vw', widths, class: cls, loading = 'lazy', style } = Astro.props;
const meta = typeof src === 'string' ? await loadImage(src) : src;
const w = (widths ?? [480, 800, 1200, 1600, 2000]).filter((x) => x <= meta.width);
---

<Image
  src={meta}
  alt={alt}
  sizes={sizes}
  widths={w.length ? w : [meta.width]}
  class={cls}
  loading={loading}
  fetchpriority={loading === 'eager' ? 'high' : undefined}
  style={style}
/>
